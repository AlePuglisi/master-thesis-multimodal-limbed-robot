language = "English",
isbn = "9781916449046",
series = "Robots in Human Life- Proceedings of the 23rd International Conference on Climbing and Walking Robots and the Support Technologies for Mobile Machines, CLAWAR 2020",
publisher = "CLAWAR Association Ltd",
pages = "297--304",
editor = "Gradetsky, {Valery G.} and Bolotnik, {Nikolay N.} and Tokhi, {Mohammad Osman} and Manuel Silva and Virk, {Gurvinder S.}",
