% TASK COMPATIBLE MANIPULABILITY
@article{TaskCompatibilityPosture,
author = {Stephen L. Chiu},
title ={Task Compatibility of Manipulator Postures},
journal = {The International Journal of Robotics Research},
volume = {7},
number = {5},
pages = {13-21},
year = {1988},
doi = {10.1177/027836498800700502},
URL = { https://doi.org/10.1177/027836498800700502},
eprint = {      https://doi.org/10.1177/027836498800700502 },   abstract = { In performing a manipulation task, humans tend to adopt arm postures that most effectively utilize the motion and strength capabilities of the arm. Selecting arm postures that are compatible with the task requirements has become almost instinctive to humans. By mimicking this approach in robotic manipulation, we can exploit the full capability of a manipulator in performing a task. An index is proposed for measuring the compatibility of manipulator postures with respect to a generalized task description. The manipulator is viewed as a mechanical transformer, with joint space velocity and force as input and task space velocity and force as output. Optimization of the index corresponds to matching the velocity and force transmission characteristics to the task requirements. The applications of this index to manipulator redundancy utilization and workspace design are also discussed. }
}

